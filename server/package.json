{
  "name": "material-shape-studio-mcp",
  "version": "0.1.0",
  "description": "Material 3 Expressive shape CLI and local MCP server for coding agents",
  "license": "Apache-2.0",
  "homepage": "https://kartollikaa.github.io/material-shape-studio/",
  "repository": { "type": "git", "url": "git+https://github.com/kartollikaa/material-shape-studio.git", "directory": "server" },
  "type": "module",
  "bin": { "material-shape-studio-mcp": "dist/stdio.mjs", "shape-studio": "dist/cli.mjs" },
